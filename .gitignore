.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Serenity reports
target/

# IDE
.idea/
*.iml

# Environment secrets
.env

# macOS
.DS_Store

# Local Android SDK copy (machine-specific, used only by local pipeline scripts)
local_sdk/

# k6 reports (generated at runtime)
api-tests/reports/*
!api-tests/reports/.gitkeep
node_modules/